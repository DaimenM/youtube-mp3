# Next.js web application (Vercel and local development)
BLOB_READ_WRITE_TOKEN=
CONVERSION_WORKER_URL=http://127.0.0.1:8080
WORKER_API_SECRET=replace-with-a-long-random-secret

# Conversion worker only
PORT=8080
WORKER_CONCURRENCY=1
MAX_QUEUE_DEPTH=25
MAX_PLAYLIST_TRACKS=50
MAX_OUTPUT_BYTES=209715200
# Optional. JSON array of browser-cookie objects; avoid unless required.
MY_COOKIES=
